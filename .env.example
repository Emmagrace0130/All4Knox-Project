# =============================================================================
# All4Knox Clinical Provider Toolkit — environment template
# =============================================================================
# Copy to `.env` and fill in the blanks. `.env` is gitignored and MUST NOT be
# committed. `.env.example` is committed and must never contain real secrets.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# Every value below is read by docker-compose.yml and passed to the containers.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment identity
# -----------------------------------------------------------------------------
# Public hostname(s) served by the shared nginx-proxy on this box.
# Comma-separated, NO spaces — nginx-proxy treats each as a vhost and
# acme-companion requests a SAN cert covering all of them.
#
# IMPORTANT: every name listed here must already have a DNS A record pointing
# at this server (160.36.100.65) BEFORE the container starts, or Let's Encrypt
# HTTP-01 validation fails and the cert is not issued.
#   all4knox.axiomsystemslab.com  -> A record exists (Gerald)
#   all4knox.rubyrecon.com        -> pending; Emma owns rubyrecon.com. Add the
#                                    A record, then append it here and restart
#                                    the frontend container. No rebuild needed.
FRONTEND_VIRTUAL_HOST=all4knox.axiomsystemslab.com
LETSENCRYPT_EMAIL=

# Shown in the UI footer / API metadata. dev | staging | production
APP_ENV=production

# -----------------------------------------------------------------------------
# Host port bindings (shared server — see docs/rules-of-engagement.md)
# -----------------------------------------------------------------------------
# These ports were confirmed free on viridian on 2026-08-30. Do not change them
# to a port you have not re-checked; other projects share this machine.
ALL4KNOX_API_PORT=8410
ALL4KNOX_WEB_PORT=8411

# -----------------------------------------------------------------------------
# Ollama — local LLM service
# -----------------------------------------------------------------------------
# Two supported ways to reach Ollama from inside the container:
#
#   1. Direct to the host daemon (fastest, no TLS, no auth, on-box only):
#        OLLAMA_BASE_URL=http://host.docker.internal:11434
#        leave OLLAMA_USERNAME / OLLAMA_PASSWORD blank
#
#   2. Through the shared authenticated reverse proxy:
#        OLLAMA_BASE_URL=https://ollama.viridian.ise.utk.edu
#        set OLLAMA_USERNAME / OLLAMA_PASSWORD  <-- GERALD: fill these in
#
# Default is (1) because it avoids a network round-trip and a shared
# dependency during the demo. Switch to (2) if the backend is ever moved off
# this host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_USERNAME=
OLLAMA_PASSWORD=

# Generation model for the "Ask All4Knox" assistant.
# gpt-oss:20b — 131k context, supports tools + thinking, ~13.8 GB on GPU.
OLLAMA_MODEL=gpt-oss:20b

# Embedding model used to build and query the vector store.
# Changing this INVALIDATES the existing index — the dimensions differ.
# Delete the index volume and re-ingest after any change here.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Seconds to wait on a generation request before giving up.
OLLAMA_TIMEOUT=120

# Context window requested on every chat call. 8192 matches the Ollama server
# default on viridian (measured 2026-09-15); asking for a different size makes
# Ollama reload gpt-oss:20b, which other projects on the box may be using. The
# assistant fits retrieved passages and chat history inside this window.
OLLAMA_NUM_CTX=8192

# -----------------------------------------------------------------------------
# Retrieval / vector store
# -----------------------------------------------------------------------------
# File-backed vector index inside the container (persisted to a named volume).
VECTOR_STORE_PATH=/data/vector_store/all4knox_index.npz

# Chunks retrieved per question from the All4Knox toolkit content. The
# reference collections (TN guidelines, TennCare BESMART) set their own limits
# and floors in backend/app/rag/tools.py.
RAG_TOP_K=6

# Minimum cosine similarity for a chunk to be considered relevant. Below this
# the model is never called at all, so it cannot answer from its own weights —
# this is the enforcement half of the guardrail in skeleton section 23.
#
# 0.65 is MEASURED, not guessed. On 2026-08-31 with nomic-embed-text over the
# current corpus, questions the content answers scored 0.745-0.828, and
# unrelated clinical questions (warfarin, metformin, pneumonia, chest pain,
# eczema, ECG) topped out at 0.579. 0.65 sits in that gap.
#
# Re-measure after changing OLLAMA_EMBEDDING_MODEL or growing the corpus:
#   python backend/tools/calibrate_threshold.py
RAG_MIN_SCORE=0.65

# Rebuild the index automatically on API startup when the corpus has changed.
RAG_AUTO_INGEST=true

# Also search the reference documents (TN buprenorphine guidelines, TennCare
# BESMART). false = toolkit content only. A kill switch; no rebuild needed,
# only `docker compose up -d api`.
RAG_REFERENCE_ENABLED=true

# -----------------------------------------------------------------------------
# Assistant safety
# -----------------------------------------------------------------------------
# Master switch. When false, /api/assistant/* returns 503 and the UI hides the
# assistant entirely. The deterministic clinical tools are unaffected — they
# never call the model.
ASSISTANT_ENABLED=true

# -----------------------------------------------------------------------------
# Accounts, sessions & persistence
# -----------------------------------------------------------------------------
# SQLite file inside the container, persisted to a named volume.
DATABASE_PATH=/data/all4knox.db

# A VISITOR session and everything hanging off it (conversations, messages) is
# DELETED after this many minutes of inactivity. This is the "wiped until they
# visit again" behaviour — do not raise it casually, it is the reason visitor
# data does not accumulate.
VISITOR_SESSION_TTL_MINUTES=120

# Signed-in sessions live longer, but are not immortal.
ACCOUNT_SESSION_TTL_DAYS=30

# Session cookie Secure flag. true in production (we serve over HTTPS).
# Set false ONLY for plain-http local development.
COOKIE_SECURE=true

# First admin account. Created ONLY when the users table is completely empty,
# so this cannot reset or re-create an admin on a running system.
# GERALD: set these once, start the stack, sign in, then BLANK THEM AGAIN.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# In production the SPA and the API share an origin (nginx proxies /api), so
# this only matters for local `npm run dev` against a containerised API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8411
